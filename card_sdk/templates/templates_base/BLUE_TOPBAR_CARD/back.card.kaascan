pace="preserve" style="font-style:normal;font-variant:normal;font-weight:300;font-stretch:normal;font-size:2.34511px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Light';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;writing-mode:lr-tb;direction:ltr;fill:#f9f9f9;fill-opacity:1;stroke:none;stroke-width:0.0193609;stroke-miterlimit:3.6;stroke-dasharray:none;stroke-opacity:0.945454;paint-order:stroke fill markers" x="64.81562" y="109.10676" id="text19-8"><tspan id="tspan19-1" style="font-style:normal;font-variant:normal;font-weight:300;font-stretch:normal;font-size:2.34511px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Light';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;fill:#f9f9f9;stroke-width:0.0193609" x="64.81562" y="109.10676">kaascan</tspan></text><text xml:space="preserve" style="font-style:normal;font-variant:normal;font-weight:800;font-stretch:normal;font-size:8.74685px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Ultra-Bold';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;writing-mode:lr-tb;direction:ltr;opacity:0.0914163;fill:#000000;fill-opacity:0.315503;stroke:none;stroke-width:0.131247;stroke-miterlimit:3.6;stroke-dasharray:none;stroke-opacity:0.945454;paint-order:stroke fill markers" x="-96.253548" y="80.213211" id="text19-8-5-4-1" transform="rotate(-55.445556)"><tspan id="tspan19-1-9-7-2" style="font-style:normal;font-variant:normal;font-weight:800;font-stretch:normal;font-size:15.8974px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Ultra-Bold';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;fill:#000000;fill-opacity:0.315503;stroke-width:0.131247" x="-96.253548" y="80.213211">kaascan</tspan></text><text xml:space="preserve" style="font-style:normal;font-variant:normal;font-weight:300;font-stretch:normal;font-size:2.00824px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Light';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;writing-mode:lr-tb;direction:ltr;opacity:1;fill:#ffffff;fill-opacity:1;stroke:none;stroke-width:0.0229595;stroke-miterlimit:3.6;stroke-dasharray:none;stroke-opacity:1;paint-order:stroke fill markers" x="25.608904" y="79.178513" id="text20"><tspan id="tspan20" x="25.608904" y="79.178513">This card may be used by the authrozied school only,</tspan><tspan id="tspan21" x="25.608904" y="81.688812">subject to the conditions as notified if found, kindly return</tspan><tspan id="tspan22" x="25.608904" y="84.199112">this card to any kaascan merchant</tspan></text><text xml:space="preserve" style="font-style:normal;font-variant:normal;font-weight:300;font-stretch:normal;font-size:2.00824px;font-family:Gilroy;-inkscape-font-specification:'Gilroy, Light';font-variant-ligatures:normal;font-variant-caps:normal;font-variant-numeric:normal;font-variant-east-asian:normal;writing-mode:lr-tb;direction:ltr;fill:#ffffff;fill-opacity:1;stroke:none;stroke-width:0.0229595;stroke-miterlimit:3.6;stroke-dasharray:none;stroke-opacity:1;paint-order:stroke fill markers" x="25.634865" y="89.35379" id="text20-0"><tspan id="tspan23" x="25.634865" y="89.35379">Iyi karita, ikoreshwa numunyeshuri ubyemerewe gusa, nkuko</tspan><tspan id="tspan24" x="25.634865" y="91.86409">amategeko abiteganya niba uyitoraguye, yisubize ku biro bya </tspan><tspan id="tspan25" x="25.634865" y="94.37439">kaascan cg kwiguriro rikwegereye</tspan></text></g></svg>