<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Kaascan: Push Card Side to SDK Template</name>
  <id>org.kaascan.sdk.push_card</id>
  <effect>
    <object-type>document</object-type>
    <effects-menu>
      <submenu name="Kaascan SDK"/>
    </effects-menu>
    <menu-tip>Push the current front/back design into the Kaascan SDK template folder and rebuild its card file.</menu-tip>
  </effect>
  <script>
    <command reldir="extensions" interpreter="python">kaascan_templates.py</command>
  </script>
  <param name="tab" type="notebook">
    <page name="target" _gui-text="Target">
      <param name="template" type="string" _gui-text="Template name" gui-description="Folder under card_sdk/templates/templates_base/. Created on first push if it does not exist.">BANK_INSPIRE</param>
      <param name="side" type="optiongroup" appearance="radio" _gui-text="Card side">
        <option value="front">Front (photo side)</option>
        <option value="back">Back (barcode side)</option>
      </param>
      <param name="page" type="string" _gui-text="Export from document page" gui-description="Leave empty to auto-pick the page for the chosen side (page 1 / label Front for front, page 2 / label Back for back). Otherwise use an id (page1), label (Front) or number (2). 'all' = whole document."></param>
      <param name="preview" type="boolean" _gui-text="Preview before exporting" gui-description="Render exactly what would be exported to a preview SVG, open it on the canvas, and do NOT touch the SDK. Re-run with this option OFF to push for real.">false</param>
      <param name="sdk_root" type="string" _gui-text="SDK repo folder" gui-description="Leave empty to auto-detect / reuse the folder from the last run."></param>
    </page>
    <page name="options" _gui-text="Options">
      <param name="clean" type="boolean" _gui-text="Strip Inkscape editor markup" gui-description="Remove namedview, inkscape/sodipodi attributes and comments so the stored design stays clean.">true</param>
      <param name="add_placeholders" type="boolean" _gui-text="Insert missing placeholders as objects" gui-description="Add the standard placeholders (e.g. {name}) as text / image objects you can drag into place.">false</param>
      <param name="snapshot_label" type="string" _gui-text="Version snapshot label" gui-description="e.g. v2 or spring-2026. Empty means no version snapshot is created."></param>
      <param name="snapshot_message" type="string" _gui-text="Snapshot message"></param>
    </page>
  </param>
  <param name="mode" type="string" gui-hidden="true">push</param>
</inkscape-extension>